# 后端环境变量示例（上线/生产用）
# 复制为 .env 或直接注入环境变量；本文件可提交，真实 .env 已被 gitignore。
#
# 本地开发可不设置（读 configs/config.yaml 的本地值）；
# 生产部署必须设置下面三项，且 APP_ENV=production 时加载 configs/config.production.yaml。

# ---- 必须项（APP_MODE=release 时强制校验）----

# JWT 签名密钥：至少 32 位强随机串，生成方式：
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }) -as [byte[]])
#   Linux:      openssl rand -base64 48
JWT_SECRET=

# MySQL 密码
MYSQL_PASSWORD=

# Redis 密码（未设置密码的 Redis 可留空）
REDIS_PASSWORD=

# ---- 可选项 ----

# 运行模式：debug / release（生产必须 release）
APP_MODE=release

# 配置环境：production 时加载 config.production.yaml
APP_ENV=production
